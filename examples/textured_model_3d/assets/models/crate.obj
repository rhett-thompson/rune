# UV-mapped cube for the textured model example.
o TexturedCrate
v -1 -1 -1
v 1 -1 -1
v 1 1 -1
v -1 1 -1
v -1 -1 1
v 1 -1 1
v 1 1 1
v -1 1 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 -1
vn 0 0 1
vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 -1 0
s off
f 2/1/1 1/2/1 4/3/1
f 2/1/1 4/3/1 3/4/1
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
f 6/1/3 2/2/3 3/3/3
f 6/1/3 3/3/3 7/4/3
f 1/1/4 5/2/4 8/3/4
f 1/1/4 8/3/4 4/4/4
f 8/1/5 7/2/5 3/3/5
f 8/1/5 3/3/5 4/4/5
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6
