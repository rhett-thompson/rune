{
  "$schema": "../../../schemas/input.schema.json",
  "actions": {
    "change_scene": [{ "type": "keyboard", "key": "SPACE" }],
    "orbit_camera": [
      {
        "type": "mouse_button",
        "button": "LEFT"
      }
    ],
    "material_view": [
      {
        "type": "keyboard",
        "key": "TAB"
      }
    ]
  },
  "axes": {
    "orbit_x": {
      "type": "mouse_delta",
      "axis": "x",
      "invert": true
    },
    "orbit_y": {
      "type": "mouse_delta",
      "axis": "y"
    },
    "zoom": {
      "type": "mouse_wheel",
      "scale": 0.75
    }
  }
}
