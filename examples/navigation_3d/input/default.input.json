{
  "$schema": "../../../schemas/input.schema.json",
  "actions": {
    "orbit_camera": [
      {
        "type": "mouse_button",
        "button": "RIGHT"
      },
      {
        "type": "gamepad_button",
        "button": "RIGHT_BUMPER"
      }
    ],
    "pan_camera": [
      {
        "type": "mouse_button",
        "button": "MIDDLE"
      }
    ],
    "focus_agent": [
      {
        "type": "keyboard",
        "key": "F"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_UP"
      }
    ],
    "reset_camera": [
      {
        "type": "keyboard",
        "key": "R"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_DOWN"
      }
    ],
    "place_mode": [
      {
        "type": "keyboard",
        "key": "C"
      }
    ],
    "undo_cube": [
      {
        "type": "keyboard",
        "key": "Z"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_LEFT"
      }
    ],
    "rebake": [
      {
        "type": "keyboard",
        "key": "N"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_RIGHT"
      }
    ],
    "pause": [
      {
        "type": "keyboard",
        "key": "P"
      },
      {
        "type": "gamepad_button",
        "button": "START"
      }
    ],
    "mesh": [
      {
        "type": "keyboard",
        "key": "M"
      },
      {
        "type": "gamepad_button",
        "button": "Y"
      }
    ],
    "stop": [
      {
        "type": "keyboard",
        "key": "SPACE"
      },
      {
        "type": "gamepad_button",
        "button": "B"
      }
    ],
    "ramp": [
      {
        "type": "keyboard",
        "key": "B"
      },
      {
        "type": "gamepad_button",
        "button": "X"
      }
    ],
    "select": [
      {
        "type": "mouse_button",
        "button": "LEFT"
      }
    ],
    "navigate_platform": [
      {
        "type": "gamepad_button",
        "button": "A"
      }
    ],
    "zoom_in": [
      {
        "type": "gamepad_button",
        "button": "RIGHT_TRIGGER"
      }
    ],
    "zoom_out": [
      {
        "type": "gamepad_button",
        "button": "LEFT_TRIGGER"
      }
    ],
    "ui_next": [
      {
        "type": "gamepad_button",
        "button": "DPAD_DOWN"
      }
    ],
    "ui_previous": [
      {
        "type": "gamepad_button",
        "button": "DPAD_UP"
      }
    ],
    "ui_left": [
      {
        "type": "gamepad_button",
        "button": "DPAD_LEFT"
      }
    ],
    "ui_right": [
      {
        "type": "gamepad_button",
        "button": "DPAD_RIGHT"
      }
    ],
    "ui_accept": [
      {
        "type": "gamepad_button",
        "button": "A"
      }
    ],
    "ui_cancel": [
      {
        "type": "gamepad_button",
        "button": "BACK"
      }
    ],
    "ui_menu": [
      {
        "type": "keyboard",
        "key": "TAB"
      },
      {
        "type": "gamepad_button",
        "button": "LEFT_THUMB"
      }
    ],
    "orbit_pad_hold": [
      {
        "type": "gamepad_button",
        "button": "RIGHT_BUMPER"
      }
    ]
  },
  "axes": {
    "orbit_x": {
      "type": "mouse_delta",
      "axis": "x"
    },
    "orbit_y": {
      "type": "mouse_delta",
      "axis": "y"
    },
    "zoom": {
      "type": "mouse_wheel"
    },
    "orbit_x_pad": {
      "type": "gamepad_axis",
      "axis": "RIGHT_X",
      "gamepad": 0,
      "deadzone": 0.15
    },
    "orbit_y_pad": {
      "type": "gamepad_axis",
      "axis": "RIGHT_Y",
      "gamepad": 0,
      "deadzone": 0.15
    }
  }
}
