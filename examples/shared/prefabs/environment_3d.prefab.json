{
  "$schema": "../../../schemas/prefab.schema.json",
  "name": "3D Environment",
  "components": {
    "Transform": {}
  },
  "children": [
    {
      "id": "sky",
      "name": "Skybox",
      "components": {
        "Skybox": {
          "mode": "procedural",
          "resolution": 16,
          "procedural": {
            "sky_top_color": [38, 49, 67, 255],
            "sky_horizon_color": [38, 49, 67, 255],
            "ground_bottom_color": [38, 49, 67, 255],
            "ground_horizon_color": [38, 49, 67, 255],
            "sun_enabled": false
          }
        }
      }
    },
    {
      "id": "post",
      "name": "Post Processing",
      "components": {
        "PostProcessing": {
          "ssao": {
            "enabled": true
          }
        }
      }
    },
    {
      "id": "ambient",
      "name": "Sky Fill",
      "components": {
        "AmbientLight": {
          "color": [165, 190, 225, 255],
          "intensity": 0.45
        }
      }
    },
    {
      "id": "sun",
      "name": "Sun",
      "components": {
        "DirectionalLight": {
          "direction": [-0.6, -1, -0.4],
          "color": [255, 240, 215, 255],
          "intensity": 2.2,
          "range": 60,
          "shadows": true,
          "shadow_softness": 2.5,
          "shadow_opacity": 1
        }
      }
    },
    {
      "id": "floor",
      "name": "Floor",
      "layers": [
        "Gameplay"
      ],
      "components": {
        "Transform": {
          "position": [0, -0.25, 0],
          "scale": [32, 0.5, 32]
        },
        "MeshRenderer": {
          "primitive": "cube",
          "color": [90, 100, 115, 255],
          "shadows": false
        },
        "BoxCollider": {
          "size": [1, 1, 1],
          "is_static": true
        }
      }
    }
  ]
}
