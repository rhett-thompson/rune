{
  "$schema": "../../../schemas/input.schema.json",
  "actions": {
    "move_left": [{ "type": "keyboard", "key": "A" }],
    "move_right": [{ "type": "keyboard", "key": "D" }],
    "move_up": [{ "type": "keyboard", "key": "W" }],
    "move_down": [{ "type": "keyboard", "key": "S" }]
  },
  "axes": {
    "move_x": { "negative": "move_left", "positive": "move_right" },
    "move_y": { "negative": "move_up", "positive": "move_down" }
  }
}
