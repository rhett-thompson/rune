{
  "$schema": "../../../schemas/scene.schema.json",
  "name": "Asteroids Arena",
  "entities": [
    {
      "id": "arena",
      "components": {
        "AsteroidsArena": {
          "width": 960,
          "height": 640,
          "star_count": 90,
          "line_color": [218, 232, 255, 255],
          "accent_color": [72, 202, 228, 255],
          "muted_color": [112, 137, 173, 255]
        }
      }
    },
    {
      "id": "player",
      "components": {
        "AsteroidsShip": {
          "position": [480, 320],
          "radius": 15,
          "thrust": 320,
          "turn_speed": 3.8,
          "drag": 0.62,
          "max_speed": 360,
          "bullet_speed": 560,
          "bullet_life": 1.15,
          "fire_delay": 0.16
        }
      }
    },
    {
      "id": "asteroid_spawner",
      "name": "Asteroid Spawner",
      "components": {
        "AsteroidSpawner": {
          "starting_lives": 3,
          "starting_count": 4,
          "max_wave_count": 12,
          "respawn_delay": 1.25,
          "invulnerable_time": 2.0
        }
      }
    },
    {
      "id": "thruster_audio",
      "name": "Thruster Audio",
      "components": {
        "AudioPlayer": {
          "default": {
            "sound": "assets/thruster.wav",
            "volume": 0.4,
            "pitch": 1.0,
            "looping": true,
            "spatial": false,
            "play_on_start": false
          }
        }
      }
    },
    {
      "id": "asteroid_destroy_audio",
      "name": "Asteroid Destroy Audio",
      "components": {
        "AudioPlayer": {
          "default": {
            "sound": "assets/asteroid_destroy.wav",
            "volume": 0.55,
            "pitch": 1.0,
            "looping": false,
            "spatial": false,
            "play_on_start": false
          }
        }
      }
    },
    {
      "id": "laser_audio",
      "name": "Laser Audio",
      "components": {
        "AudioPlayer": {
          "default": {
            "sound": "assets/laser.wav",
            "volume": 0.45,
            "pitch": 1.0,
            "looping": false,
            "spatial": false,
            "play_on_start": false
          }
        }
      }
    },
    {
      "id": "music_audio",
      "name": "Background Music",
      "components": {
        "AudioPlayer": {
          "default": {
            "sound": "assets/music.mp3",
            "volume": 0.25,
            "pitch": 1.0,
            "looping": true,
            "spatial": false,
            "play_on_start": true
          }
        }
      }
    },
    {
      "id": "ship_explode_audio",
      "name": "Ship Explosion Audio",
      "components": {
        "AudioPlayer": {
          "default": {
            "sound": "assets/explode.wav",
            "volume": 0.65,
            "pitch": 1.0,
            "looping": false,
            "spatial": false,
            "play_on_start": false
          }
        }
      }
    }
  ]
