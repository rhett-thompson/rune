{
  "$schema": "../../../schemas/scene.schema.json",
  "name": "Independent Animation Players",
  "entities": [
    { "id": "camera", "components": {
      "Transform": { "position": [4, 4, 11] },
      "Camera3D": { "target": [1, 1, 0], "active": true, "fovy": 45 },
      "OrbitCamera3D": {
        "target": [1, 1, 0],
        "yaw": 74.745,
        "pitch": 14.743,
        "distance": 11.79,
        "min_distance": 3,
        "max_distance": 24,
        "manual_action": "orbit_camera",
        "yaw_axis": "orbit_x",
        "pitch_axis": "orbit_y",
        "zoom_axis": "zoom",
        "pan_action": "pan_camera",
        "pan_x_axis": "pan_x",
        "pan_y_axis": "pan_y",
        "pan_sensitivity": 0.0015,
        "orbit_sensitivity": 0.35,
        "zoom_sensitivity": 1
      }
    } },
    {
      "id": "environment",
      "prefab": "../../shared/prefabs/environment_3d.prefab.json"
    },
    { "id": "left", "components": {
      "Transform": { "position": [-2,0,0] },
      "ModelRenderer": { "model": "assets/arm.gltf", "tint": [80,180,255,255] },
      "ModelAnimator": { "clip": "bend", "speed": 1, "events": "assets/arm.model-events.json" },
      "AudioPlayer": {
        "step": {"sound": "../assets/brackeys_platformer_assets/sounds/tap.wav", "volume": 0.2},
        "impact": {"sound": "../assets/brackeys_platformer_assets/sounds/hurt.wav", "volume": 0.2}
      }
    } },
    { "id": "middle", "components": {
      "Transform": { "position": [0,0,0] },
      "ModelRenderer": { "model": "assets/arm.gltf", "tint": [255,190,70,255] },
      "ModelAnimator": { "clip": "bend", "speed": 0.5 }
    } },
    { "id": "right", "components": {
      "Transform": { "position": [2,0,0] },
      "ModelRenderer": { "model": "assets/arm.gltf", "tint": [90,230,160,255] },
      "ModelAnimator": { "clip": "sway" }
    } },
    { "id": "strut", "components": {
      "Transform": { "position": [4,0,0], "scale": [0.01,0.01,0.01] },
      "ModelRenderer": {
        "model": "../assets/Strut Walking.fbx",
        "materials": {
          "0": "assets/materials/strut.material.json",
          "1": "assets/materials/strut-joints.material.json"
        }
      },
      "ModelAnimator": { "clip": "mixamo.com", "speed": 1, "loop": true }
    } }
  ]
}
