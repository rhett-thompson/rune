{
  "$schema": "../../../schemas/input.schema.json",
  "actions": {
    "punch": [{ "type": "keyboard", "key": "SPACE" }],
    "orbit_camera": [{ "type": "mouse_button", "button": "LEFT" }],
    "pan_camera": [{ "type": "mouse_button", "button": "MIDDLE" }],
    "speed": [{ "type": "keyboard", "key": "S" }],
    "reverse": [{ "type": "keyboard", "key": "V" }],
    "seek": [{ "type": "keyboard", "key": "H" }],
    "pause": [{ "type": "keyboard", "key": "P" }],
    "resume": [{ "type": "keyboard", "key": "R" }],
    "bend": [{ "type": "keyboard", "key": "1" }],
    "sway": [{ "type": "keyboard", "key": "2" }]
  },
  "axes": {
    "orbit_x": { "type": "mouse_delta", "axis": "x", "invert": true },
    "orbit_y": { "type": "mouse_delta", "axis": "y" },
    "pan_x": { "type": "mouse_delta", "axis": "x" },
    "pan_y": { "type": "mouse_delta", "axis": "y" },
    "zoom": { "type": "mouse_wheel", "scale": 0.75 }
  }
}
