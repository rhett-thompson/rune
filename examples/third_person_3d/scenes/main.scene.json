{
  "$schema": "../../../schemas/scene.schema.json",
  "name": "Third Person Movement Course",
  "entities": [
    {
      "id": "checkpoint_zone",
      "name": "Green checkpoint zone",
      "components": {
        "Transform": {
          "position": [-5, 1, 8]
        },
        "Trigger3D": {
          "shape": "box",
          "size": [2.5, 2, 2.5],
          "layers": 4
        },
        "ZoneEffect": {
          "kind": "checkpoint",
          "spawn_position": [-5, 0.05, 8]
        }
      },
      "children": [
        {
          "id": "checkpoint_pad",
          "components": {
            "Transform": {
              "position": [0, -0.97, 0],
              "scale": [2.5, 0.06, 2.5]
            },
            "MeshRenderer": {
              "primitive": "cube",
              "color": [40, 155, 100, 255],
              "shadows": false
            }
          }
        }
      ]
    },
    {
      "id": "hazard_zone",
      "name": "Red hazard zone",
      "components": {
        "Transform": {
          "position": [5, 0.8, 8]
        },
        "Trigger3D": {
          "shape": "sphere",
          "radius": 1.4,
          "layers": 4
        },
        "ZoneEffect": {
          "kind": "hazard",
          "damage": 25
        }
      },
      "children": [
        {
          "id": "hazard_pad",
          "components": {
            "Transform": {
              "position": [0, -0.77, 0],
              "scale": [2, 0.06, 2]
            },
            "MeshRenderer": {
              "primitive": "cube",
              "color": [165, 45, 45, 255],
              "shadows": false
            }
          }
        }
      ]
    },
    {
      "id": "interaction_door",
      "name": "Door switch",
      "layers": [
        "Gameplay"
      ],
      "components": {
        "Transform": {
          "position": [0, 1.25, 6.5],
          "scale": [2, 2.5, 0.36]
        },
        "Interactable3D": {
          "prompt": "Requires a brass key"
        },
        "DoorState": {
          "required_key": "brass_key",
          "unlocked": false,
          "open": false
        },
        "MeshRenderer": {
          "primitive": "cube",
          "color": [60, 145, 185, 255],
          "shadows": true
        },
        "BoxCollider": {
          "size": [1, 1, 1],
          "is_static": true
        }
      }
    },
    {
      "id": "interaction_pickup",
      "name": "Brass key",
      "layers": [
        "Gameplay"
      ],
      "components": {
        "Transform": {
          "position": [-2, 0.85, 8]
        },
        "Pickup": {
          "item_id": "brass_key",
          "quantity": 1
        },
        "Interactable3D": {
          "prompt": "Take brass key"
        }
      },
      "children": [
        {
          "id": "key_head",
          "components": {
            "Transform": {
              "position": [0, 0.28, 0],
              "scale": [0.4, 0.4, 0.14]
            },
            "MeshRenderer": {
              "primitive": "cube",
              "color": [255, 198, 60, 255],
              "shadows": true
            }
          }
        },
        {
          "id": "key_stem",
          "components": {
            "Transform": {
              "position": [0, -0.16, 0],
              "scale": [0.13, 0.5, 0.13]
            },
            "MeshRenderer": {
              "primitive": "cube",
              "color": [255, 198, 60, 255],
              "shadows": true
            }
          }
        },
        {
          "id": "key_tooth",
          "components": {
            "Transform": {
              "position": [0.12, -0.32, 0],
              "scale": [0.23, 0.12, 0.13]
            },
            "MeshRenderer": {
              "primitive": "cube",
              "color": [255, 198, 60, 255],
              "shadows": true
            }
          }
        }
      ]
    },
    {
      "id": "interaction_guide",
      "name": "Course guide",
      "layers": [
        "Gameplay"
      ],
      "components": {
        "Transform": {
          "position": [2, 0.85, 8]
        },
        "BoxCollider": {
          "size": [0.65, 1.7, 0.5],
          "is_static": true
        },
        "Interactable3D": {
          "prompt": "Talk to guide",
          "offset": [0, 0.35, 0],
          "hold_seconds": 0.75
        }
      },
      "children": [
        {
          "id": "interaction_guide_body",
          "components": {
            "Transform": {
              "scale": [0.65, 1.7, 0.5]
            },
            "MeshRenderer": {
              "primitive": "cube",
              "color": [165, 105, 210, 255],
              "shadows": true
            }
          }
        },
        {
          "id": "interaction_guide_head",
          "components": {
            "Transform": {
              "position": [0, 1.05, 0]
            },
            "SphereRenderer": {
              "radius": 0.3,
              "color": [245, 211, 170, 255],
              "shadows": true
            }
          }
        }
      ]
    },
    {
      "id": "environment",
      "prefab": "../../shared/prefabs/environment_3d.prefab.json",
      "child_overrides": {
        "post": {
          "component_overrides": {
            "PostProcessing": {
              "fog": {
                "mode": "linear",
                "color": [38, 49, 67, 255],
                "start": 12,
                "end": 45,
                "sky_affect": 0
              }
            }
          }
        }
      }
    },
    {
      "id": "player",
      "name": "Player",
      "layers": [
        "Gameplay",
        "Player"
      ],
      "components": {
        "Transform": {
          "position": [0, 0, 10]
        },
        "AudioPlayer": {
          "footsteps": {
            "clips": [
              "../first_person_3d/assets/audio/concrete_1.wav",
              "../first_person_3d/assets/audio/concrete_2.wav",
              "../first_person_3d/assets/audio/concrete_3.wav",
              "../first_person_3d/assets/audio/concrete_4.wav"
            ],
            "volume": 0.5,
            "random_pitch": 0.04,
            "max_voices": 4,
            "bus": "sfx"
          }
        },
        "CharacterController3D": {},
        "Interactor3D": {},
        "Inventory": {},
        "RespawnPoint": {},
        "Health": {},
        "ThirdPersonController": {
          "footstep_stride": 2.4,
          "camera_smoothing": 12,
          "collision_margin": 0.2,
          "initial_pitch": 22,
          "turn_speed": 12,
          "zoom_speed": 0.8,
          "target_height_ratio": 0.65,
          "mouse_sensitivity": 0.25,
          "initial_yaw": 180,
          "max_distance": 12,
          "distance": 6,
          "min_distance": 2
        }
      },
      "children": [
        {
          "id": "player_body",
          "components": {
            "Transform": {
              "position": [0, 0.71, 0],
              "scale": [0.55, 1.42, 0.4]
            },
            "MeshRenderer": {
              "color": [55, 180, 195, 255],
              "primitive": "cube",
              "shadows": true
            }
          },
          "name": "Player Body"
        },
        {
          "id": "player_head",
          "components": {
            "Transform": {
              "position": [0, 1.61, 0]
            },
            "SphereRenderer": {
              "color": [235, 220, 190, 255],
              "shadows": true,
              "radius": 0.19
            }
          },
          "name": "Player Head"
        },
        {
          "id": "player_front",
          "components": {
            "Transform": {
              "position": [0, 1.61, -0.18],
              "scale": [0.28, 0.1, 0.07]
            },
            "MeshRenderer": {
              "color": [30, 45, 65, 255],
              "primitive": "cube",
              "shadows": true
            }
          },
          "name": "Player Visor"
        }
      ]
    },
    {
      "id": "follow_camera",
      "name": "Third Person Camera",
      "components": {
        "Transform": {
          "position": [0, 1.6, 10]
        },
        "Camera3D": {
          "target": [0, 1.6, 9],
          "up": [0, 1, 0],
          "fovy": 60,
          "active": true
        }
      }
    },
    {
      "id": "course",
      "prefab": "../../shared/prefabs/controller_course.prefab.json"
    }
  ]
}
