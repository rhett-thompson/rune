{
  "$schema": "../../../schemas/scene.schema.json",
  "name": "Third Person Playground",
  "entities": [
    {
      "id": "floor",
      "name": "Floor",
      "layers": ["Gameplay"],
      "components": {
        "Transform": { "position": [0, -0.15, 0], "scale": [30, 0.3, 30] },
        "MeshRenderer": { "primitive": "cube", "color": [96, 145, 104, 255] },
        "BoxCollider": { "size": [1, 1, 1], "is_static": true }
      }
    },
    {
      "id": "player",
      "name": "Player",
      "layers": ["Gameplay", "Player"],
      "components": {
        "Transform": { "position": [0, 0.75, 3], "scale": [0.8, 1.5, 0.8], "rotation": [0, 180, 0] },
        "MeshRenderer": { "primitive": "cube", "color": [45, 125, 230, 255] },
        "CharacterController": { "radius": 0.35, "height": 1.5, "eye_height": 0.75, "gravity": 24, "jump_speed": 8 }
      },
      "children": [
        {
          "id": "player_front",
          "name": "Player Front Marker",
          "components": {
            "Transform": { "position": [0, 0, 0.8], "scale": [0.3, 0.3, 0.4] },
            "MeshRenderer": { "primitive": "cube", "color": [245, 245, 245, 255] }
          }
        }
      ]
    },
    {
      "id": "landmark_left",
      "name": "Left Landmark",
      "layers": ["Gameplay"],
      "components": {
        "Transform": { "position": [-6, 1.5, -4], "scale": [2, 3, 2] },
        "MeshRenderer": { "primitive": "cube", "color": [245, 180, 65, 255] },
        "BoxCollider": { "size": [1, 1, 1], "is_static": true }
      }
    },
    {
      "id": "landmark_right",
      "name": "Right Landmark",
      "layers": ["Gameplay"],
      "components": {
        "Transform": { "position": [6, 1, -7], "scale": [2, 2, 2] },
        "MeshRenderer": { "primitive": "cube", "color": [224, 95, 114, 255] },
        "BoxCollider": { "size": [1, 1, 1], "is_static": true }
      }
    },
    {
      "id": "look_target",
      "name": "Look Target",
      "layers": ["Gameplay"],
      "components": {
        "Transform": { "position": [0, 0.75, -9] },
        "SphereRenderer": { "radius": 0.75, "color": [250, 235, 110, 255] },
        "SphereCollider": { "radius": 0.75, "is_static": true }
      }
    },
    {
      "id": "follow_camera",
      "name": "Follow Camera",
      "components": {
        "Transform": { "position": [0, 5, -5] },
        "Camera3D": { "target": [0, 1, 3], "up": [0, 1, 0], "fovy": 55, "active": true }
      }
    }
  ]
}
