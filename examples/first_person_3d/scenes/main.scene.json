        "Transform": { "position": [0, -0.25, 0], "scale": [24, 0.5, 24] },
        "MeshRenderer": { "primitive": "cube", "color": [90, 100, 115, 255] },
        "BoxCollider": { "size": [1, 1, 1], "is_static": true }
      }
    },
    {
      "id": "wall_north",
      "name": "North Wall",
