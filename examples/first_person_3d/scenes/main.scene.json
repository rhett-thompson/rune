      "components": {
        "Transform": { "position": [0, 2, -12], "scale": [24, 4, 0.5] },
        "MeshRenderer": { "primitive": "cube", "color": [130, 140, 155, 255] },
        "BoxCollider": { "size": [1, 1, 1], "is_static": true }
      }
    },
    {
      "id": "wall_west",
      "name": "West Wall",
	  "layers": ["Gameplay"],
      "components": {
        "Transform": { "position": [-12, 2, 0], "scale": [0.5, 4, 24] },
        "MeshRenderer": { "primitive": "cube", "color": [130, 140, 155, 255] },
        "BoxCollider": { "size": [1, 1, 1], "is_static": true }
      }
    },
    {
      "id": "blue_block",
      "name": "Blue Block",
	  "layers": ["Gameplay"],
      "components": {
        "Transform": { "position": [3, 1, -4], "scale": [2, 2, 2] },
        "MeshRenderer": { "primitive": "cube", "color": [102, 191, 255, 255] },
        "BoxCollider": { "size": [1, 1, 1], "is_static": true }
      }
