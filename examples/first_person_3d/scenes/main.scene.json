{
  "$schema": "../../../schemas/scene.schema.json",
  "name": "First Person Blockout",
  "entities": [
    {
      "id": "environment",
      "prefab": "../../shared/prefabs/environment_3d.prefab.json"
    },
    {
      "id": "player",
      "name": "Player",
      "layers": [
        "Gameplay",
        "Player"
      ],
      "components": {
        "Transform": {
          "position": [0, 0, 10]
        },
        "FirstPersonController": {
          "mouse_sensitivity": 0.15,
          "eye_inset": 0.2,
          "crouch_transition_time": 0.18,
          "footstep_stride": 2.4,
          "head_bob_enabled": true,
          "head_bob_vertical": 0.018,
          "head_bob_horizontal": 0.009,
          "head_bob_frequency": 1.8,
          "head_bob_smoothing": 12
        },
        "WeaponViewmodel": {
          "enabled": true,
          "position": [0.24, -0.22, -0.5],
          "rotation": [-3, -6, -3],
          "scale": 1,
          "fov": 55,
          "jump_motion_strength": 1
        },
        "AudioPlayer": {
          "footsteps": {
            "clips": [
              "assets/audio/concrete_1.wav",
              "assets/audio/concrete_2.wav",
              "assets/audio/concrete_3.wav",
              "assets/audio/concrete_4.wav"
            ],
            "volume": 0.5,
            "random_pitch": 0.04,
            "max_voices": 4,
            "bus": "sfx"
          }
        },
        "CharacterController3D": {}
      }
    },
    {
      "id": "camera",
      "name": "First Person Camera",
      "components": {
        "Transform": {
          "position": [0, 1.6, 10]
        },
        "Camera3D": {
          "target": [0, 1.6, 9],
          "up": [0, 1, 0],
          "fovy": 70,
          "active": true
        }
      }
    },
    {
      "id": "course",
      "prefab": "../../shared/prefabs/controller_course.prefab.json"
    }
  ]
}
