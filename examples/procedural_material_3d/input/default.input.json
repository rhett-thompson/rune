    "grass": [{ "type": "keyboard", "key": "4" }],
    "granite": [{ "type": "keyboard", "key": "5" }],
    "wood": [{ "type": "keyboard", "key": "6" }],
    "sand": [{ "type": "keyboard", "key": "7" }],
