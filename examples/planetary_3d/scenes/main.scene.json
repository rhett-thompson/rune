          "easing_rate": 5,
          "facing_turn_speed": 8,
          "facing_easing_rate": 12
        }
      }
    },
    {
      "id": "follow_camera",
      "components": {
        "Transform": {
          "position": [
            0,
            13,
            22
          ]
        },
        "Camera3D": {
          "target": [
            0,
            9,
            0
          ],
          "up": [
            0,
            1,
            0
          ],
          "fovy": 65,
          "active": true
        },
        "OrientationSmoothing": {
          "max_turn_speed": 2.4,
          "angular_acceleration": 5,
          "easing_rate": 5
        }
      }
    }
  ]
}
