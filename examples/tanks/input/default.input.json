{
  "$schema": "../../../schemas/input.schema.json",
  "actions": {
    "left_forward": [
      {
        "type": "keyboard",
        "key": "W"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_UP",
        "gamepad": 0
      }
    ],
    "left_back": [
      {
        "type": "keyboard",
        "key": "S"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_DOWN",
        "gamepad": 0
      }
    ],
    "left_turn_left": [
      {
        "type": "keyboard",
        "key": "A"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_LEFT",
        "gamepad": 0
      }
    ],
    "left_turn_right": [
      {
        "type": "keyboard",
        "key": "D"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_RIGHT",
        "gamepad": 0
      }
    ],
    "right_forward": [
      {
        "type": "keyboard",
        "key": "UP"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_UP",
        "gamepad": 1
      }
    ],
    "right_back": [
      {
        "type": "keyboard",
        "key": "DOWN"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_DOWN",
        "gamepad": 1
      }
    ],
    "right_turn_left": [
      {
        "type": "keyboard",
        "key": "LEFT"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_LEFT",
        "gamepad": 1
      }
    ],
    "right_turn_right": [
      {
        "type": "keyboard",
        "key": "RIGHT"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_RIGHT",
        "gamepad": 1
      }
    ],
    "right_fire": [
      {
        "type": "keyboard",
        "key": "ENTER"
      },
      {
        "type": "gamepad_button",
        "button": "RIGHT_TRIGGER",
        "gamepad": 1
      }
    ],
    "toggle_players": [
      {
        "type": "keyboard",
        "key": "P"
      },
      {
        "type": "gamepad_button",
        "button": "START",
        "gamepad": 0
      }
    ],
    "restart": [
      {
        "type": "keyboard",
        "key": "R"
      },
      {
        "type": "gamepad_button",
        "button": "BACK",
        "gamepad": 0
      }
    ],
    "left_fire": [
      {
        "type": "mouse_button",
        "button": "LEFT"
      },
      {
        "type": "gamepad_button",
        "button": "RIGHT_TRIGGER",
        "gamepad": 0
      }
    ]
  },
  "axes": {
    "left_move": {
      "negative": "left_back",
      "positive": "left_forward"
    },
    "left_turn": {
      "negative": "left_turn_left",
      "positive": "left_turn_right"
    },
    "right_move": {
      "negative": "right_back",
      "positive": "right_forward"
    },
    "right_turn": {
      "negative": "right_turn_left",
      "positive": "right_turn_right"
    },
    "left_move_pad": {
      "type": "gamepad_axis",
      "axis": "LEFT_Y",
      "gamepad": 0,
      "deadzone": 0.15,
      "invert": true
    },
    "left_turn_pad": {
      "type": "gamepad_axis",
      "axis": "LEFT_X",
      "gamepad": 0,
      "deadzone": 0.15
    },
    "left_aim_x": {
      "type": "gamepad_axis",
      "axis": "RIGHT_X",
      "gamepad": 0,
      "deadzone": 0.15
    },
    "left_aim_y": {
      "type": "gamepad_axis",
      "axis": "RIGHT_Y",
      "gamepad": 0,
      "deadzone": 0.15
    },
    "right_move_pad": {
      "type": "gamepad_axis",
      "axis": "LEFT_Y",
      "gamepad": 1,
      "deadzone": 0.15,
      "invert": true
    },
    "right_turn_pad": {
      "type": "gamepad_axis",
      "axis": "LEFT_X",
      "gamepad": 1,
      "deadzone": 0.15
    },
    "right_aim_x": {
      "type": "gamepad_axis",
      "axis": "RIGHT_X",
      "gamepad": 1,
      "deadzone": 0.15
    },
    "right_aim_y": {
      "type": "gamepad_axis",
      "axis": "RIGHT_Y",
      "gamepad": 1,
      "deadzone": 0.15
    }
  }
}
