{
  "$schema": "../../../schemas/scene.schema.json",
  "name": "Tanks Arena",
  "entities": [
    {
      "id": "arena",
      "components": {
        "TanksArena": {
          "width": 960,
          "height": 600,
          "border": 10,
          "background_color": [8, 12, 24, 255],
          "grid_color": [22, 33, 51, 255],
          "wall_color": [61, 75, 99, 255],
          "text_color": [245, 245, 245, 255],
          "muted_text_color": [151, 168, 198, 255],
          "walls": [
            [255, 120, 45, 190],
            [660, 290, 45, 190],
            [410, 235, 140, 45],
            [410, 410, 140, 45]
          ]
        },
        "NavGrid2D": {
          "cell_size": 20,
          "algorithm": "theta_star"
        },
        "AudioPlayer": {
          "music": {
            "sound": "../assets/shared/arcade_music.mp3",
            "volume": 0.35,
            "looping": true,
            "play_on_start": true
          },
          "ricochet": {
            "sound": "assets/ricochet.wav",
            "volume": 0.7,
            "random_pitch": 0.06
          },
          "tank_explode": {
            "sound": "assets/tank_explode.wav",
            "volume": 0.85,
            "random_pitch": 0.04
          },
          "bullet_explode": {
            "sound": "assets/bullet_explode.wav",
            "volume": 0.7,
            "random_pitch": 0.08
          },
          "shoot": {
            "sound": "assets/shoot.wav",
            "volume": 0.75,
            "random_pitch": 0.05,
            "random_volume": 0.05
          }
        }
      }
    },
    {
      "id": "blue_tank",
      "components": {
        "Tank": {
          "position": [110, 300],
          "spawn": [110, 300],
          "angle": 0,
          "spawn_angle": 0,
          "radius": 23,
          "move_speed": 155,
          "turn_speed": 145,
          "fire_cooldown": 1.15,
          "max_shot_bounces": 1,
          "input_prefix": "left",
          "computer": false,
          "body_color": [72, 202, 228, 255],
          "tread_color": [26, 104, 125, 255]
        }
      }
    },
    {
      "id": "orange_tank",
      "components": {
        "Tank": {
          "position": [850, 300],
          "spawn": [850, 300],
          "angle": 180,
          "spawn_angle": 180,
          "radius": 23,
          "move_speed": 145,
          "turn_speed": 135,
          "fire_cooldown": 1.3,
          "max_shot_bounces": 1,
          "input_prefix": "right",
          "computer": true,
          "body_color": [246, 166, 35, 255],
          "tread_color": [139, 82, 17, 255]
        },
        "NavAgent2D": {
          "radius": 23,
          "repath_interval": 0.25,
          "arrival_distance": 8
        }
      }
    },
    {
      "id": "match",
      "components": {
        "TanksMatch": {
          "left_score": 0,
          "right_score": 0,
          "win_score": 5,
          "two_player": false,
          "game_over": false,
          "round_delay": 1.5
        }
      }
    }
  ]
}
