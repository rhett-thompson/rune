{
  "$schema": "../../../schemas/input.schema.json",
  "actions": {
    "toggle": [
      {
        "type": "keyboard",
        "key": "SPACE"
      },
      {
        "type": "gamepad_button",
        "button": "A"
      }
    ],
    "bloom": [
      {
        "type": "keyboard",
        "key": "B"
      },
      {
        "type": "gamepad_button",
        "button": "B"
      }
    ],
    "ssao": [
      {
        "type": "keyboard",
        "key": "O"
      },
      {
        "type": "gamepad_button",
        "button": "X"
      }
    ],
    "dof": [
      {
        "type": "keyboard",
        "key": "D"
      },
      {
        "type": "gamepad_button",
        "button": "Y"
      }
    ],
    "tonemap": [
      {
        "type": "keyboard",
        "key": "T"
      },
      {
        "type": "gamepad_button",
        "button": "LEFT_BUMPER"
      }
    ],
    "exposure_up": [
      {
        "type": "keyboard",
        "key": "UP"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_UP"
      }
    ],
    "exposure_down": [
      {
        "type": "keyboard",
        "key": "DOWN"
      },
      {
        "type": "gamepad_button",
        "button": "DPAD_DOWN"
      }
    ],
    "orbit_camera": [
      {
        "type": "mouse_button",
        "button": "LEFT"
      },
      {
        "type": "gamepad_button",
        "button": "RIGHT_BUMPER"
      }
    ],
    "zoom_in": [
      {
        "type": "gamepad_button",
        "button": "RIGHT_TRIGGER"
      }
    ],
    "zoom_out": [
      {
        "type": "gamepad_button",
        "button": "LEFT_TRIGGER"
      }
    ]
  },
  "axes": {
    "orbit_x": {
      "type": "mouse_delta",
      "axis": "x",
      "invert": true
    },
    "orbit_y": {
      "type": "mouse_delta",
      "axis": "y"
    },
    "orbit_x_pad": {
      "type": "gamepad_axis",
      "axis": "RIGHT_X",
      "gamepad": 0,
      "deadzone": 0.15,
      "invert": true
    },
    "orbit_y_pad": {
      "type": "gamepad_axis",
      "axis": "RIGHT_Y",
      "gamepad": 0,
      "deadzone": 0.15
    }
  }
}
