# Shell entry points must remain runnable after a Windows checkout or export.
*.sh text eol=lf
*.bat text eol=crlf
# Illustrator source artwork must retain its original binary contents.
*.ai binary
# Patch comparison and archive blob manifests use canonical LF on every host.
third_party/r3d-compat/bindings.patch text eol=lf
third_party/r3d-compat/files.blobs text eol=lf
# Blank context lines in unified patches retain their leading marker space.
third_party/r3d-shadows/foreground-view.patch text eol=lf whitespace=-blank-at-eol
third_party/r3d-shadows/light-scissor.patch text eol=lf whitespace=-blank-at-eol
