{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components.schema.json",
  "title": "Rune component map",
  "type": "object",
  "description": "Components attached to an entity. Custom Odin components are allowed.",
  "properties": {
    "PostProcessing": { "$ref": "post-processing.schema.json" },
    "ShapeRenderer2D": { "$ref": "#/$defs/shapeRenderer2D" },
    "Lifetime": { "$ref": "#/$defs/lifetime" },
    "Transform": { "$ref": "#/$defs/transform" },
    "SpriteRenderer": { "$ref": "#/$defs/spriteRenderer" },
    "SpriteAnimator": { "$ref": "#/$defs/spriteAnimator" },
    "ParticleEmitter2D": { "$ref": "#/$defs/particleEmitter2D" },
    "MeshRenderer": { "$ref": "#/$defs/meshRenderer" },
    "SphereRenderer": { "$ref": "#/$defs/sphereRenderer" },
    "ModelRenderer": { "$ref": "#/$defs/modelRenderer" },
    "ModelAnimator": { "$ref": "#/$defs/modelAnimator" },
    "AmbientLight": { "$ref": "#/$defs/ambientLight" },
    "DirectionalLight": { "$ref": "#/$defs/directionalLight" },
    "PointLight": { "$ref": "#/$defs/pointLight" },
    "SpotLight": { "$ref": "#/$defs/spotLight" },
    "TilemapRenderer": { "$ref": "#/$defs/tilemapRenderer" },
    "TextRenderer": { "$ref": "#/$defs/textRenderer" },
    "Camera2D": { "$ref": "#/$defs/camera2D" },
    "CameraFollow2D": { "$ref": "#/$defs/cameraFollow2D" },
    "Camera3D": { "$ref": "#/$defs/camera3D" },
    "OrbitCamera3D": { "$ref": "#/$defs/orbitCamera3D" },
    "RigidBody2D": { "$ref": "#/$defs/rigidBody2D" },
    "RigidBody3D": { "$ref": "#/$defs/rigidBody3D" },
    "BoxCollider2D": { "$ref": "#/$defs/boxCollider2D" },
    "PolygonCollider2D": { "$ref": "#/$defs/polygonCollider2D" },
    "SegmentCollider2D": { "$ref": "#/$defs/segmentCollider2D" },
    "CharacterController2D": { "$ref": "#/$defs/characterController2D" },
    "CapsuleCollider2D": { "$ref": "#/$defs/capsuleCollider2D" },
    "CircleCollider2D": { "$ref": "#/$defs/circleCollider2D" },
    "BoxCollider": { "$ref": "#/$defs/boxCollider" },
    "SphereCollider": { "$ref": "#/$defs/sphereCollider" },
    "CharacterController": { "$ref": "#/$defs/characterController" },
    "TilemapCollider": { "$ref": "#/$defs/tilemapCollider" },
    "TopDownController": { "$ref": "#/$defs/topDownController" },
    "AudioListener": { "$ref": "#/$defs/audioListener" },
    "AudioPlayer": { "$ref": "#/$defs/audioPlayers" },
    "NavGrid2D": { "$ref": "#/$defs/navGrid2D" },
    "NavAgent2D": { "$ref": "#/$defs/navAgent2D" },
    "Orbit": { "$ref": "#/$defs/orbit" },
    "Rotator": { "$ref": "#/$defs/rotator" }
  },
  "additionalProperties": {
    "type": "object",
    "description": "Data for a custom component registered by game code."
  },
  "$defs": {
    "characterController2D": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fixed-step motor requiring Transform, dynamic RigidBody2D and a solid vertical CapsuleCollider2D. Distances use world units; times use seconds; slope uses degrees.",
      "properties": {
        "move_speed": {
          "type": "number",
          "default": 200,
          "minimum": 0
        },
        "acceleration": {
          "type": "number",
          "default": 1600,
          "exclusiveMinimum": 0
        },
        "air_acceleration": {
          "type": "number",
          "default": 800,
          "minimum": 0
        },
        "gravity": {
          "type": "number",
          "default": 1200,
          "exclusiveMinimum": 0
        },
        "jump_speed": {
          "type": "number",
          "default": 460,
          "minimum": 0
        },
        "max_fall_speed": {
          "type": "number",
          "default": 900,
          "exclusiveMinimum": 0
        },
        "max_slope_angle": {
          "type": "number",
          "default": 45,
          "minimum": 0,
          "exclusiveMaximum": 89
        },
        "ground_snap_distance": {
          "type": "number",
          "default": 8,
          "minimum": 0
        },
        "coyote_time": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1
        },
        "jump_buffer_time": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1
        },
        "drop_speed": {
          "type": "number",
          "default": 60,
          "exclusiveMinimum": 0
        },
        "drop_time": {
          "type": "number",
          "default": 0.15,
          "minimum": 0,
          "maximum": 1
        },
        "crouch_height": {
          "type": "number",
          "minimum": 0,
          "default": 20,
          "description": "Local crouched height, clamped to capsule diameter and standing height. Zero disables crouching."
        },
        "crouch_speed": {
          "type": "number",
          "minimum": 0,
          "default": 100,
          "description": "Horizontal target speed while crouched, relative to supporting platform."
        }
      }
    },
    "polygonCollider2D": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertices"
      ],
      "description": "3-8 convex perimeter vertices, clockwise or counterclockwise. Rune rejects crossed, collinear, duplicate or too-close vertices.",
      "properties": {
        "vertices": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 8
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0,
            0
          ]
        },
        "is_sensor": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "segmentCollider2D": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "description": "Endpoints must be more than 0.005 units apart. One-way segments require equal endpoint Y coordinates (checked by Rune).",
      "properties": {
        "start": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "end": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0,
            0
          ]
        },
        "is_sensor": {
          "type": "boolean",
          "default": false
        },
        "one_way": {
          "type": "boolean",
          "default": false,
          "description": "Collide only with the horizontal top from above; cannot be combined with is_sensor."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "one_way": {
                "const": true
              }
            },
            "required": [
              "one_way"
            ]
          },
          "then": {
            "properties": {
              "is_sensor": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "capsuleCollider2D": {
      "type": "object",
      "additionalProperties": false,
      "description": "Axis-aligned capsule. Height includes both caps and must be at least twice radius (checked by Rune).",
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 8
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 32
        },
        "axis": {
          "enum": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical"
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0,
            0
          ]
        },
        "is_sensor": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "shapeRenderer2D": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "rectangle",
            "circle"
          ],
          "default": "rectangle"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            32,
            32
          ]
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 16
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0.5,
            0.5
          ]
        },
        "color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 4,
          "maxItems": 4,
          "default": [
            255,
            255,
            255,
            255
          ]
        },
        "filled": {
          "type": "boolean",
          "default": true
        },
        "line_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "draw_order": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000,
          "default": 0
        }
      }
    },
    "lifetime": {
      "type": "object",
      "required": [
        "seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Simulation seconds before destroying this entity and its children; suspended while disabled."
        }
      }
    },
    "particleEmitter2D": {
      "type": "object",
      "description": "World-space CPU particles. Transform sets emission position/direction and scales diameter; live particles remain independent.",
      "properties": {
        "max_particles": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 256 },
        "emitting": { "type": "boolean", "default": true, "description": "Continuous emission. False lets existing particles finish; Odin bursts still work." },
        "rate": { "type": "number", "minimum": 0, "maximum": 100000, "default": 30, "description": "Particles per simulation second." },
        "lifetime": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2, "default": [0.5, 1], "description": "Minimum/maximum lifetime in seconds; maximum must be >= minimum." },
        "speed": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 2, "default": [40, 100], "description": "Minimum/maximum speed in world units per second; maximum must be >= minimum." },
        "angle": { "type": "number", "default": -90, "description": "Degrees clockwise from +X; -90 points up. Transform Z rotation is added." },
        "spread": { "type": "number", "minimum": 0, "maximum": 360, "default": 30, "description": "Full cone angle in degrees, centered on angle." },
        "gravity": { "$ref": "#/$defs/vec2", "default": [0, 0], "description": "World-space acceleration in units per second squared." },
        "start_size": { "type": "number", "minimum": 0, "default": 8, "description": "Initial diameter in world units." },
        "end_size": { "type": "number", "minimum": 0, "default": 0, "description": "Final diameter; interpolated linearly over lifetime." },
        "start_color": { "$ref": "#/$defs/color", "default": [255, 220, 120, 255] },
        "end_color": { "$ref": "#/$defs/color", "default": [255, 80, 30, 0] },
        "texture": { "type": "string", "default": "", "description": "Optional cached texture drawn as a square. Empty draws circles." },
        "additive": { "type": "boolean", "default": false },
        "draw_order": { "type": "integer", "minimum": -1000000, "maximum": 1000000, "default": 0 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 1, "description": "Per-emitter random seed; zero uses 1. Changing seed resets particles." }
      },
      "additionalProperties": false
    },
    "modelAnimator": {
      "type": "object",
      "properties": {
        "clip": { "type": "string", "default": "", "description": "Embedded clip name; empty selects the first clip." },
        "blend_time": { "type": "number", "minimum": 0, "default": 0 },
        "speed": { "type": "number", "not": { "const": 0 }, "default": 1 },
        "loop": { "type": "boolean", "default": true },
        "autoplay": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "vec2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "vec4": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "color": {
      "type": "array",
      "description": "RGBA color with channels from 0 through 255.",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 4,
      "maxItems": 4
    },
    "component": {
      "type": "object",
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "rotation": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "scale": { "$ref": "#/$defs/vec3", "default": [1, 1, 1] }
      },
      "additionalProperties": false
    },
    "spriteRenderer": {
      "type": "object",
      "properties": {
        "texture": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/vec2", "default": [0.5, 0.5] },
        "source": { "$ref": "#/$defs/vec4", "default": [0, 0, 0, 0], "description": "Texture source rectangle. Zero width or height selects the full texture." },
        "tint": { "$ref": "#/$defs/color", "default": [255, 255, 255, 255] },
        "flip_x": { "type": "boolean", "default": false },
        "flip_y": { "type": "boolean", "default": false },
        "draw_order": { "type": "integer", "minimum": -1000000, "maximum": 1000000, "default": 0 }
      },
      "additionalProperties": false
    },
    "spriteAnimator": {
      "type": "object",
      "required": ["animation", "clip"],
      "properties": {
        "animation": { "type": "string", "minLength": 1 },
        "clip": { "type": "string", "minLength": 1 },
        "autoplay": { "type": "boolean", "default": true },
        "speed": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      },
      "additionalProperties": false
    },
    "meshRenderer": {
      "type": "object",
      "properties": {
        "primitive": { "type": "string", "enum": ["cube", "plane"] },
        "color": { "$ref": "#/$defs/color" },
        "material": { "type": "string", "minLength": 1 },
        "shadows": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "sphereRenderer": {
      "type": "object",
      "properties": {
        "radius": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "color": { "$ref": "#/$defs/color" },
        "material": { "type": "string", "minLength": 1 },
        "shadows": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "modelRenderer": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "tint": { "$ref": "#/$defs/color" },
        "material": { "type": "string", "minLength": 1 },
        "materials": {
          "type": "object",
          "description": "Material overrides keyed by zero-based raylib material slot index.",
          "patternProperties": {
            "^[0-9]+$": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ambientLight": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 0.2 }
      },
      "additionalProperties": false
    },
    "directionalLight": {
      "type": "object",
      "properties": {
        "direction": { "$ref": "#/$defs/vec3", "default": [-0.35, -1, -0.45] },
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 1 },
        "range": { "type": "number", "exclusiveMinimum": 0, "default": 16, "description": "Directional shadow radius around the camera." },
        "specular": { "type": "number", "minimum": 0, "default": 1 },
        "shadows": { "type": "boolean", "default": false },
        "shadow_softness": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_opacity": { "type": "number", "minimum": 0, "default": 1 },
        "shadow_depth_bias": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_slope_bias": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "pointLight": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 1 },
        "range": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
        "specular": { "type": "number", "minimum": 0, "default": 1 },
        "shadows": { "type": "boolean", "default": false },
        "shadow_softness": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_opacity": { "type": "number", "minimum": 0, "default": 1 },
        "shadow_depth_bias": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_slope_bias": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "spotLight": {
      "type": "object",
      "properties": {
        "direction": { "$ref": "#/$defs/vec3", "default": [0, -1, 0] },
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 1 },
        "range": { "type": "number", "exclusiveMinimum": 0, "default": 8 },
        "inner_angle": { "type": "number", "exclusiveMinimum": 0, "default": 18 },
        "outer_angle": { "type": "number", "exclusiveMinimum": 0, "default": 32 },
        "specular": { "type": "number", "minimum": 0, "default": 1 },
        "shadows": { "type": "boolean", "default": false },
        "shadow_softness": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_opacity": { "type": "number", "minimum": 0, "default": 1 },
        "shadow_depth_bias": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_slope_bias": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "tilemapRenderer": {
      "type": "object",
      "required": ["grid"],
      "anyOf": [
        { "required": ["tileset"] },
        { "required": ["texture", "tile_size"] }
      ],
      "properties": {
        "tileset": { "type": "string", "minLength": 1 },
        "texture": { "type": "string", "minLength": 1 },
        "tile_size": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "draw_order": { "type": "integer", "minimum": -1000000, "maximum": 1000000, "default": 0 },
        "grid": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": -1 }
          }
        }
      },
      "additionalProperties": false
    },
    "textRenderer": {
      "type": "object",
      "required": ["text", "font"],
      "properties": {
        "text": { "type": "string" },
        "font": { "type": "string", "minLength": 1 },
        "font_size": { "type": "number", "exclusiveMinimum": 0, "default": 20 },
        "spacing": { "type": "number", "default": 0 },
        "color": { "$ref": "#/$defs/color" },
        "origin": { "$ref": "#/$defs/vec2" },
        "draw_order": { "type": "integer", "minimum": -1000000, "maximum": 1000000, "default": 0 }
      },
      "additionalProperties": false
    },
    "camera2D": {
      "type": "object",
      "properties": {
        "offset": { "$ref": "#/$defs/vec2" },
        "zoom": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "rotation": { "type": "number", "default": 0 },
        "active": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "cameraFollow2D": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "type": "string", "minLength": 1, "description": "Scene entity ID to follow." },
        "dead_zone": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "default": [0, 0]
        },
        "smoothing": { "type": "number", "minimum": 0, "default": 0 },
        "bounds": {
          "$ref": "#/$defs/vec4",
          "description": "Optional world bounds [min_x, min_y, max_x, max_y]."
        }
      },
      "additionalProperties": false
    },
    "camera3D": {
      "type": "object",
      "properties": {
        "target": { "$ref": "#/$defs/vec3" },
        "up": { "$ref": "#/$defs/vec3", "default": [0, 1, 0] },
        "fovy": { "type": "number", "exclusiveMinimum": 0, "default": 45 },
        "active": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "orbitCamera3D": {
      "type": "object",
      "properties": {
        "target": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "yaw": { "type": "number", "default": 0 },
        "pitch": { "type": "number", "default": 25 },
        "distance": { "type": "number", "exclusiveMinimum": 0, "default": 8 },
        "min_pitch": { "type": "number", "default": -80 },
        "max_pitch": { "type": "number", "default": 80 },
        "min_distance": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "max_distance": { "type": "number", "exclusiveMinimum": 0, "default": 100 },
        "auto_yaw_speed": { "type": "number", "default": 0 },
        "manual_action": { "type": "string", "default": "orbit_camera" },
        "yaw_axis": { "type": "string", "default": "orbit_x" },
        "pitch_axis": { "type": "string", "default": "orbit_y" },
        "zoom_axis": { "type": "string", "default": "zoom" },
        "orbit_sensitivity": { "type": "number", "exclusiveMinimum": 0, "default": 0.35 },
        "zoom_sensitivity": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      },
      "additionalProperties": false
    },
    "rigidBody2D": {
      "type": "object",
      "properties": {
        "velocity": { "$ref": "#/$defs/vec2" },
        "gravity_scale": { "type": "number", "minimum": 0, "default": 1 },
        "type": { "type": "string", "enum": ["dynamic", "kinematic", "static"], "default": "dynamic" }
      },
      "additionalProperties": false
    },
    "rigidBody3D": {
      "type": "object",
      "properties": {
        "velocity": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "angular_velocity": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "gravity_scale": { "type": "number", "minimum": 0, "default": 1 },
        "type": { "type": "string", "enum": ["dynamic", "kinematic", "static"], "default": "dynamic" },
