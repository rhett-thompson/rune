{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components.schema.json",
  "title": "Rune component map",
  "type": "object",
  "description": "Components attached to an entity. Custom Odin components are allowed.",
  "properties": {
    "Transform": { "$ref": "#/$defs/transform" },
    "SpriteRenderer": { "$ref": "#/$defs/spriteRenderer" },
    "MeshRenderer": { "$ref": "#/$defs/meshRenderer" },
    "SphereRenderer": { "$ref": "#/$defs/sphereRenderer" },
    "ModelRenderer": { "$ref": "#/$defs/modelRenderer" },
    "AmbientLight": { "$ref": "#/$defs/ambientLight" },
    "DirectionalLight": { "$ref": "#/$defs/directionalLight" },
    "PointLight": { "$ref": "#/$defs/pointLight" },
    "SpotLight": { "$ref": "#/$defs/spotLight" },
    "TilemapRenderer": { "$ref": "#/$defs/tilemapRenderer" },
    "TextRenderer": { "$ref": "#/$defs/textRenderer" },
    "Camera2D": { "$ref": "#/$defs/camera2D" },
    "Camera3D": { "$ref": "#/$defs/camera3D" },
    "OrbitCamera3D": { "$ref": "#/$defs/orbitCamera3D" },
    "RigidBody2D": { "$ref": "#/$defs/rigidBody2D" },
    "RigidBody3D": { "$ref": "#/$defs/rigidBody3D" },
    "BoxCollider2D": { "$ref": "#/$defs/boxCollider2D" },
    "CircleCollider2D": { "$ref": "#/$defs/circleCollider2D" },
    "BoxCollider": { "$ref": "#/$defs/boxCollider" },
    "SphereCollider": { "$ref": "#/$defs/sphereCollider" },
    "CharacterController": { "$ref": "#/$defs/characterController" },
    "TilemapCollider": { "$ref": "#/$defs/tilemapCollider" },
    "TopDownController": { "$ref": "#/$defs/topDownController" },
    "AudioListener": { "$ref": "#/$defs/audioListener" },
    "AudioPlayer": { "$ref": "#/$defs/audioPlayers" },
    "NavGrid2D": { "$ref": "#/$defs/navGrid2D" },
    "NavAgent2D": { "$ref": "#/$defs/navAgent2D" },
    "Orbit": { "$ref": "#/$defs/orbit" },
    "Rotator": { "$ref": "#/$defs/rotator" }
  },
  "additionalProperties": {
    "type": "object",
    "description": "Data for a custom component registered by game code."
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "array",
      "description": "RGBA color with channels from 0 through 255.",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 4,
      "maxItems": 4
    },
    "component": {
      "type": "object",
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "rotation": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "scale": { "$ref": "#/$defs/vec3", "default": [1, 1, 1] }
      },
      "additionalProperties": false
    },
    "spriteRenderer": {
      "type": "object",
      "properties": {
        "texture": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/vec2", "default": [0.5, 0.5] }
      },
      "additionalProperties": false
    },
    "meshRenderer": {
      "type": "object",
      "properties": {
        "primitive": { "type": "string", "enum": ["cube", "plane"] },
        "color": { "$ref": "#/$defs/color" },
        "material": { "type": "string", "minLength": 1 },
        "shadows": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "sphereRenderer": {
      "type": "object",
      "properties": {
        "radius": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "color": { "$ref": "#/$defs/color" },
        "material": { "type": "string", "minLength": 1 },
        "shadows": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "modelRenderer": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "tint": { "$ref": "#/$defs/color" },
        "material": { "type": "string", "minLength": 1 },
        "materials": {
          "type": "object",
          "description": "Material overrides keyed by zero-based raylib material slot index.",
          "patternProperties": {
            "^[0-9]+$": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ambientLight": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 0.2 }
      },
      "additionalProperties": false
    },
    "directionalLight": {
      "type": "object",
      "properties": {
        "direction": { "$ref": "#/$defs/vec3", "default": [-0.35, -1, -0.45] },
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 1 },
        "range": { "type": "number", "exclusiveMinimum": 0, "default": 16, "description": "Directional shadow radius around the camera." },
        "specular": { "type": "number", "minimum": 0, "default": 1 },
        "shadows": { "type": "boolean", "default": false },
        "shadow_softness": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_opacity": { "type": "number", "minimum": 0, "default": 1 },
        "shadow_depth_bias": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_slope_bias": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "pointLight": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 1 },
        "range": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
        "specular": { "type": "number", "minimum": 0, "default": 1 },
        "shadows": { "type": "boolean", "default": false },
        "shadow_softness": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_opacity": { "type": "number", "minimum": 0, "default": 1 },
        "shadow_depth_bias": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_slope_bias": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "spotLight": {
      "type": "object",
      "properties": {
        "direction": { "$ref": "#/$defs/vec3", "default": [0, -1, 0] },
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "default": 1 },
        "range": { "type": "number", "exclusiveMinimum": 0, "default": 8 },
        "inner_angle": { "type": "number", "exclusiveMinimum": 0, "default": 18 },
        "outer_angle": { "type": "number", "exclusiveMinimum": 0, "default": 32 },
        "specular": { "type": "number", "minimum": 0, "default": 1 },
        "shadows": { "type": "boolean", "default": false },
        "shadow_softness": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_opacity": { "type": "number", "minimum": 0, "default": 1 },
        "shadow_depth_bias": { "type": "number", "minimum": 0, "default": 0 },
        "shadow_slope_bias": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "tilemapRenderer": {
      "type": "object",
      "required": ["texture", "tile_size", "grid"],
      "properties": {
        "texture": { "type": "string", "minLength": 1 },
        "tile_size": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "grid": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": -1 }
          }
        }
      },
      "additionalProperties": false
    },
    "textRenderer": {
      "type": "object",
      "required": ["text", "font"],
      "properties": {
        "text": { "type": "string" },
        "font": { "type": "string", "minLength": 1 },
        "font_size": { "type": "number", "exclusiveMinimum": 0, "default": 20 },
        "spacing": { "type": "number", "default": 0 },
        "color": { "$ref": "#/$defs/color" },
        "origin": { "$ref": "#/$defs/vec2" }
      },
      "additionalProperties": false
    },
    "camera2D": {
      "type": "object",
      "properties": {
        "offset": { "$ref": "#/$defs/vec2" },
        "zoom": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "rotation": { "type": "number", "default": 0 },
        "active": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "camera3D": {
      "type": "object",
      "properties": {
        "target": { "$ref": "#/$defs/vec3" },
        "up": { "$ref": "#/$defs/vec3", "default": [0, 1, 0] },
        "fovy": { "type": "number", "exclusiveMinimum": 0, "default": 45 },
        "active": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "orbitCamera3D": {
      "type": "object",
      "properties": {
        "target": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "yaw": { "type": "number", "default": 0 },
        "pitch": { "type": "number", "default": 25 },
        "distance": { "type": "number", "exclusiveMinimum": 0, "default": 8 },
        "min_pitch": { "type": "number", "default": -80 },
        "max_pitch": { "type": "number", "default": 80 },
        "min_distance": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "max_distance": { "type": "number", "exclusiveMinimum": 0, "default": 100 },
        "auto_yaw_speed": { "type": "number", "default": 0 },
        "manual_action": { "type": "string", "default": "orbit_camera" },
        "yaw_axis": { "type": "string", "default": "orbit_x" },
        "pitch_axis": { "type": "string", "default": "orbit_y" },
        "zoom_axis": { "type": "string", "default": "zoom" },
        "orbit_sensitivity": { "type": "number", "exclusiveMinimum": 0, "default": 0.35 },
        "zoom_sensitivity": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      },
      "additionalProperties": false
    },
    "rigidBody2D": {
      "type": "object",
      "properties": {
        "velocity": { "$ref": "#/$defs/vec2" },
        "gravity_scale": { "type": "number", "minimum": 0, "default": 1 },
        "type": { "type": "string", "enum": ["dynamic", "kinematic", "static"], "default": "dynamic" }
      },
      "additionalProperties": false
    },
    "rigidBody3D": {
      "type": "object",
      "properties": {
        "velocity": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "angular_velocity": { "$ref": "#/$defs/vec3", "default": [0, 0, 0] },
        "gravity_scale": { "type": "number", "minimum": 0, "default": 1 },
        "type": { "type": "string", "enum": ["dynamic", "kinematic", "static"], "default": "dynamic" },
        "linear_damping": { "type": "number", "minimum": 0, "default": 0 },
        "angular_damping": { "type": "number", "minimum": 0, "default": 0 },
        "allow_fast_rotation": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "boxCollider2D": {
      "type": "object",
      "properties": { "size": { "$ref": "#/$defs/vec2", "default": [16, 16] } },
      "additionalProperties": false
    },
    "circleCollider2D": {
      "type": "object",
      "properties": { "radius": { "type": "number", "exclusiveMinimum": 0, "default": 8 } },
      "additionalProperties": false
    },
    "physicsMaterial": {
      "type": "object",
      "properties": {
        "friction": { "type": "number", "minimum": 0, "default": 0.6 },
        "restitution": { "type": "number", "minimum": 0, "default": 0 },
        "rolling_resistance": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "boxCollider": {
      "type": "object",
      "properties": {
        "size": { "$ref": "#/$defs/vec3", "default": [1, 1, 1] },
        "is_static": { "type": "boolean", "default": true },
        "friction": { "type": "number", "minimum": 0, "default": 0.6 },
        "restitution": { "type": "number", "minimum": 0, "default": 0 },
        "rolling_resistance": { "type": "number", "minimum": 0, "default": 0 },
        "physics_material": { "$ref": "#/$defs/physicsMaterial" }
      },
      "additionalProperties": false
    },
    "sphereCollider": {
      "type": "object",
      "properties": {
        "radius": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 },
        "is_static": { "type": "boolean", "default": true },
        "friction": { "type": "number", "minimum": 0, "default": 0.6 },
        "restitution": { "type": "number", "minimum": 0, "default": 0 },
        "rolling_resistance": { "type": "number", "minimum": 0, "default": 0 },
        "physics_material": { "$ref": "#/$defs/physicsMaterial" }
      },
      "additionalProperties": false
    },
    "characterController": {
      "type": "object",
      "properties": {
        "radius": { "type": "number", "exclusiveMinimum": 0, "default": 0.35 },
        "height": { "type": "number", "exclusiveMinimum": 0, "default": 1.8 },
        "eye_height": { "type": "number", "exclusiveMinimum": 0, "default": 1.6 },
        "gravity": { "type": "number", "exclusiveMinimum": 0, "default": 24 },
        "jump_speed": { "type": "number", "exclusiveMinimum": 0, "default": 8 }
      },
      "additionalProperties": false
    },
    "tilemapCollider": {
      "type": "object",
      "required": ["solid_tiles"],
      "properties": {
        "solid_tiles": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "topDownController": {
      "type": "object",
      "properties": {
        "size": { "$ref": "#/$defs/vec2", "default": [16, 16] },
        "speed": { "type": "number", "exclusiveMinimum": 0, "default": 180 }
      },
      "additionalProperties": false
    },
    "audioListener": {
      "type": "object",
      "properties": { "active": { "type": "boolean", "default": true } },
      "additionalProperties": false
    },
    "audioPlayers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/audioPlayer" }
    },
    "audioPlayer": {
      "type": "object",
      "required": ["sound"],
      "properties": {
        "sound": { "type": "string", "minLength": 1 },
        "volume": { "type": "number", "minimum": 0, "default": 1 },
        "pitch": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "random_volume": { "type": "number", "minimum": 0, "default": 0 },
        "random_pitch": { "type": "number", "minimum": 0, "default": 0 },
        "max_voices": { "type": "integer", "minimum": 1, "default": 4 },
        "looping": { "type": "boolean", "default": false },
        "play_on_start": { "type": "boolean", "default": false },
        "spatial": { "type": "boolean", "default": false },
        "min_distance": { "type": "number", "minimum": 0, "default": 1 },
        "max_distance": { "type": "number", "minimum": 0, "default": 20 }
      },
      "additionalProperties": false
    },
    "navGrid2D": {
      "type": "object",
      "properties": {
        "cell_size": { "type": "number", "exclusiveMinimum": 0, "default": 24 },
        "algorithm": { "type": "string", "enum": ["a_star", "theta_star"], "default": "a_star" }
      },
      "additionalProperties": false
    },
    "navAgent2D": {
      "type": "object",
      "properties": {
        "radius": { "type": "number", "exclusiveMinimum": 0, "default": 8 },
        "repath_interval": { "type": "number", "exclusiveMinimum": 0, "default": 0.25 },
        "arrival_distance": { "type": "number", "minimum": 0, "default": 4 }
      },
      "additionalProperties": false
    },
    "orbit": {
      "type": "object",
      "required": ["degrees_per_second"],
      "properties": {
        "degrees_per_second": { "type": "number" }
      },
      "additionalProperties": false
    },
    "rotator": {
      "type": "object",
      "required": ["degrees_per_second"],
      "properties": { "degrees_per_second": { "type": "number" } },
      "additionalProperties": false
    }
  }
}
