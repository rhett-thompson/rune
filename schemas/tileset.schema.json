{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tileset.schema.json",
  "title": "Rune tileset",
  "type": "object",
  "required": ["texture", "tile_size", "tiles"],
  "properties": {
    "$schema": { "type": "string" },
    "texture": { "type": "string", "minLength": 1 },
    "tile_size": {
      "type": "array",
      "items": { "type": "integer", "exclusiveMinimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "tiles": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(0|[1-9][0-9]*)$": { "$ref": "#/$defs/tile" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cell": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "size": {
      "type": "array",
      "items": { "type": "integer", "exclusiveMinimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "nonNegativeVector2": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "positiveVector2": {
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "collision": {
      "type": "object",
      "required": ["offset", "size"],
      "properties": {
        "offset": {
          "$ref": "#/$defs/nonNegativeVector2",
          "description": "Collision offset from the tile's top-left anchor, in base tile cells."
        },
        "size": {
          "$ref": "#/$defs/positiveVector2",
          "description": "Collision width and height in base tile cells."
        }
      },
      "additionalProperties": false
    },
    "tile": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": {
          "$ref": "#/$defs/cell",
          "description": "Top-left atlas cell for this tile."
        },
        "size": {
          "$ref": "#/$defs/size",
          "description": "Width and height in base tile cells; defaults to one cell.",
          "default": [1, 1]
        },
        "collision": {
          "$ref": "#/$defs/collision",
          "description": "Optional collision rectangle within the tile's visual footprint."
        }
      },
      "additionalProperties": false
    }
  }
}
