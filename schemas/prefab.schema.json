{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab.schema.json",
  "title": "Rune prefab",
  "type": "object",
  "required": ["name", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "enabled": { "type": "boolean", "default": true, "description": "Local activation; disabled parents suspend their children." },
    "name": { "type": "string", "minLength": 1 },
    "components": { "$ref": "components.schema.json" },
    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/child" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "child": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "Local activation; disabled parents suspend their children." },
        "name": { "type": "string" },
        "components": { "$ref": "components.schema.json" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/child" }
        }
      },
      "additionalProperties": false
    }
  }
}
