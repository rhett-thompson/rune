{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"navmesh.schema.json","title":"Rune 3D navigation mesh",
  "type":"object","additionalProperties":false,
  "required":["version","agent_radius","agent_height","vertices","triangles"],
  "properties":{
    "$schema":{"type":"string"},
    "version":{"const":1},
    "agent_radius":{"type":"number","minimum":0,"description":"Radius clearance already accounted for in the authored center surface."},
    "agent_height":{"type":"number","exclusiveMinimum":0,"description":"Headroom already checked by the author or exporter."},
    "vertices":{"type":"array","minItems":3,"maxItems":131072,"items":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":-1000000,"maximum":1000000}}},
    "triangles":{"type":"array","minItems":1,"maxItems":65536,"items":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"integer","minimum":0}}}
  }
}
