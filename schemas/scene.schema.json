{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene.schema.json",
  "title": "Rune scene",
  "type": "object",
  "required": ["name", "entities"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "description": "Display name of the scene." },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entity": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Scene-unique entity identifier." },
        "name": { "type": "string" },
        "tag": { "type": "string" },
        "layers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "prefab": { "type": "string", "minLength": 1, "description": "Path relative to this scene file." },
        "components": { "$ref": "components.schema.json" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity" }
        }
      },
      "additionalProperties": false
    }
  }
}
