{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "Rune input mappings",
  "type": "object",
  "required": ["actions", "axes"],
  "properties": {
    "$schema": { "type": "string" },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/binding" },
        "minItems": 1
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/axis" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "oneOf": [
        {
          "title": "Keyboard binding",
          "type": "object",
          "required": ["type", "key"],
          "properties": {
            "type": { "const": "keyboard" },
            "key": {
              "anyOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9]$" },
                {
                  "type": "string",
                  "enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "SPACE", "LEFT", "RIGHT", "UP", "DOWN", "ESCAPE", "ESC", "ENTER", "TAB", "BACKSPACE", "LEFT_SHIFT", "RIGHT_SHIFT", "LEFT_CONTROL", "LEFT_CTRL", "RIGHT_CONTROL", "RIGHT_CTRL", "APOSTROPHE", "COMMA", "MINUS", "PERIOD", "SLASH", "SEMICOLON", "EQUAL", "LEFT_BRACKET", "BACKSLASH", "RIGHT_BRACKET", "GRAVE", "INSERT", "DELETE", "PAGE_UP", "PAGE_DOWN", "HOME", "END", "CAPS_LOCK", "SCROLL_LOCK", "NUM_LOCK", "PRINT_SCREEN", "PAUSE", "LEFT_ALT", "LEFT_SUPER", "RIGHT_ALT", "RIGHT_SUPER", "KB_MENU", "KP_0", "KP_1", "KP_2", "KP_3", "KP_4", "KP_5", "KP_6", "KP_7", "KP_8", "KP_9", "KP_DECIMAL", "KP_DIVIDE", "KP_MULTIPLY", "KP_SUBTRACT", "KP_ADD", "KP_ENTER", "KP_EQUAL", "BACK", "MENU", "VOLUME_UP", "VOLUME_DOWN", "ZERO", "ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE"]
                }
              ],
              "examples": ["W", "SPACE", "LEFT_SHIFT"]
            }
          },
          "additionalProperties": false
        },
        {
          "title": "Mouse button binding",
          "type": "object",
          "required": ["type", "button"],
          "properties": {
            "type": { "const": "mouse_button" },
            "button": {
              "type": "string",
              "enum": ["LEFT", "RIGHT", "MIDDLE", "SIDE", "EXTRA", "FORWARD", "BACK"]
            }
          },
          "additionalProperties": false
        },
        {
          "title": "Gamepad button binding",
          "type": "object",
          "required": ["type", "button"],
          "properties": {
            "type": { "const": "gamepad_button" },
            "button": {
              "type": "string",
              "enum": ["A", "B", "X", "Y", "DPAD_UP", "DPAD_RIGHT", "DPAD_DOWN", "DPAD_LEFT", "LEFT_BUMPER", "RIGHT_BUMPER", "LEFT_TRIGGER", "RIGHT_TRIGGER", "BACK", "START", "GUIDE", "LEFT_THUMB", "RIGHT_THUMB"]
            },
            "gamepad": { "type": "integer", "minimum": 0, "default": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "axis": {
      "oneOf": [
        {
          "title": "Action axis",
          "type": "object",
          "required": ["negative", "positive"],
          "properties": {
            "negative": { "type": "string" },
            "positive": { "type": "string" },
            "invert": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        {
          "title": "Mouse delta axis",
          "type": "object",
          "required": ["type", "axis"],
          "properties": {
            "type": { "const": "mouse_delta" },
            "axis": { "type": "string", "enum": ["x", "y"] },
            "scale": { "type": "number", "default": 1 },
            "invert": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        {
          "title": "Gamepad axis",
          "type": "object",
          "required": ["type", "axis"],
          "properties": {
            "type": { "const": "gamepad_axis" },
            "axis": { "type": "string", "enum": ["LEFT_X", "LEFT_Y", "RIGHT_X", "RIGHT_Y", "LEFT_TRIGGER", "RIGHT_TRIGGER"] },
            "gamepad": { "type": "integer", "minimum": 0, "default": 0 },
            "deadzone": { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0 },
            "scale": { "type": "number", "default": 1 },
            "invert": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        {
          "title": "Mouse wheel axis",
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "mouse_wheel" },
            "scale": { "type": "number", "default": 1 },
            "invert": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
