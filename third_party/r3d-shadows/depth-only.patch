+// Opaque depth shares R3D's submissions, material cutouts and vertex/skinning
+// shaders, without touching lights, probes, screen chains or exposure history.
+bool Rune_R3D_BeginDepthCapture(void)
+{
+    if (DEPTH_VIEW_ACTIVE || LINEAR_VIEW_ACTIVE) return false;
+    DEPTH_VIEW_ACTIVE = true;
+    DEPTH_VIEW_CAPTURED = false;
+    DEPTH_VIEW_TEXTURE = (Texture2D){0};
+    return true;
+}
+
+bool Rune_R3D_EndDepthCapture(Texture2D* depth)
+{
+    if (!DEPTH_VIEW_ACTIVE) return false;
+    DEPTH_VIEW_ACTIVE = false;
+    if (depth) *depth = DEPTH_VIEW_TEXTURE;
+    return DEPTH_VIEW_CAPTURED;
+}
