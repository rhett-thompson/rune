+r3d_target_t pass_pre_transparency(r3d_target_t sceneTarget)
+{
+    bool hasShader = false;
+    for (int i = 0; i < R3D_ARRAY_SIZE(PRE_TRANSPARENCY_SHADERS); i++)
+    {
+        if (PRE_TRANSPARENCY_SHADERS[i] != NULL) hasShader = true;
+    }
+    if (!hasShader) return sceneTarget;
+
+    sceneTarget = pass_post_setup(sceneTarget);
+    sceneTarget = pass_screen_chain(PRE_TRANSPARENCY_SHADERS,
+        R3D_ARRAY_SIZE(PRE_TRANSPARENCY_SHADERS), sceneTarget);
+    // Post passes return the next destination, whereas scene rendering takes
+    // the target containing the latest image.
+    return r3d_target_swap_scene(sceneTarget);
+}
