+// Rune-owned insertion point. Keep storage separate from R3D's pinned core
+// state so the bundled archive's public stages and private layouts stay intact.
+static R3D_ScreenShader* PRE_TRANSPARENCY_SHADERS[R3D_MAX_SCREEN_SHADERS];
+
+void Rune_R3D_SetPreTransparencyShaderChain(R3D_ScreenShader** shaders, int count)
+{
+    int capacity = R3D_ARRAY_SIZE(PRE_TRANSPARENCY_SHADERS);
+    if (count > capacity) count = capacity;
+    for (int i = 0; i < capacity; i++)
+    {
+        PRE_TRANSPARENCY_SHADERS[i] = shaders != NULL && i < count ? shaders[i] : NULL;
+    }
+}
