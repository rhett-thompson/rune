+// Rune's offscreen views use this same deferred/HDR pipeline. Capture before
+// display conversion; these borrowed textures are copied before the next view.
+static bool LINEAR_VIEW_ACTIVE;
+static bool LINEAR_VIEW_CAPTURED;
+static Texture2D LINEAR_VIEW_COLOR;
+static Texture2D LINEAR_VIEW_DEPTH;
+static R3D_ScreenShader* LINEAR_VIEW_SCREEN_SHADERS[R3D_SCREEN_SHADER_STAGE_COUNT][R3D_MAX_SCREEN_SHADERS];
+static R3D_ScreenShader* LINEAR_VIEW_PRE_TRANSPARENCY[R3D_MAX_SCREEN_SHADERS];
+typedef struct { R3D_Light id; bool enabled; } rune_view_light_t;
+static rune_view_light_t* LINEAR_VIEW_LIGHTS;
+static int LINEAR_VIEW_LIGHT_COUNT;
+
+bool Rune_R3D_BeginLinearViewCapture(bool inheritLights)
+{
+    if (LINEAR_VIEW_ACTIVE) return false;
+    LINEAR_VIEW_LIGHT_COUNT = 0;
+    LINEAR_VIEW_LIGHTS = NULL;
+    if (!inheritLights && R3D_MOD_LIGHT.pool->count > 0)
+    {
+        LINEAR_VIEW_LIGHTS = MemAlloc(R3D_MOD_LIGHT.pool->count * sizeof(rune_view_light_t));
+        if (!LINEAR_VIEW_LIGHTS) return false;
+        R3D_POOL_FOR_EACH(R3D_MOD_LIGHT.pool, r3d_light_t, light, index)
+        {
+            LINEAR_VIEW_LIGHTS[LINEAR_VIEW_LIGHT_COUNT++] = (rune_view_light_t){index + 1, light->enabled};
+            light->enabled = false;
+        }
+    }
+    for (int stage = 0; stage < R3D_SCREEN_SHADER_STAGE_COUNT; stage++)
+    {
+        for (int i = 0; i < R3D_MAX_SCREEN_SHADERS; i++)
+        {
+            LINEAR_VIEW_SCREEN_SHADERS[stage][i] = R3D.screenShaders[stage][i];
+            R3D.screenShaders[stage][i] = NULL;
+        }
+    }
+    for (int i = 0; i < R3D_MAX_SCREEN_SHADERS; i++)
+    {
+        LINEAR_VIEW_PRE_TRANSPARENCY[i] = PRE_TRANSPARENCY_SHADERS[i];
+        PRE_TRANSPARENCY_SHADERS[i] = NULL;
+    }
+    LINEAR_VIEW_ACTIVE = true;
+    LINEAR_VIEW_CAPTURED = false;
+    LINEAR_VIEW_COLOR = (Texture2D){0};
+    LINEAR_VIEW_DEPTH = (Texture2D){0};
+    return true;
+}
+
+bool Rune_R3D_EndLinearViewCapture(Texture2D* color, Texture2D* depth)
+{
+    if (!LINEAR_VIEW_ACTIVE) return false;
+    for (int stage = 0; stage < R3D_SCREEN_SHADER_STAGE_COUNT; stage++)
+        for (int i = 0; i < R3D_MAX_SCREEN_SHADERS; i++)
+            R3D.screenShaders[stage][i] = LINEAR_VIEW_SCREEN_SHADERS[stage][i];
+    for (int i = 0; i < R3D_MAX_SCREEN_SHADERS; i++)
+        PRE_TRANSPARENCY_SHADERS[i] = LINEAR_VIEW_PRE_TRANSPARENCY[i];
+    for (int i = 0; i < LINEAR_VIEW_LIGHT_COUNT; i++)
+    {
+        r3d_light_t* light = r3d_light_get(LINEAR_VIEW_LIGHTS[i].id);
+        if (light) light->enabled = LINEAR_VIEW_LIGHTS[i].enabled;
+    }
+    MemFree(LINEAR_VIEW_LIGHTS);
+    LINEAR_VIEW_LIGHTS = NULL;
+    LINEAR_VIEW_LIGHT_COUNT = 0;
+    LINEAR_VIEW_ACTIVE = false;
+    if (color) *color = LINEAR_VIEW_COLOR;
+    if (depth) *depth = LINEAR_VIEW_DEPTH;
+    return LINEAR_VIEW_CAPTURED;
+}
+
 void R3D_Begin(Camera3D camera)
 {
     R3D_BeginEx(R3D_CameraFromRL(camera));
@@ -298,12 +367,24 @@ void R3D_End(void)
         sceneTarget = pass_post_bloom(sceneTarget);
