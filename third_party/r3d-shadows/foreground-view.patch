-    if (R3D.environment.autoExposure.enabled)
+    if (R3D.environment.autoExposure.enabled && !LINEAR_VIEW_ACTIVE)
     {
         sceneTarget = pass_post_auto_exposure(sceneTarget);
     }
 
     sceneTarget = pass_post_screen(R3D_SCREEN_SHADER_STAGE_POST, sceneTarget);
+    if (LINEAR_VIEW_ACTIVE)
+    {
+        r3d_target_t source = r3d_target_swap_scene(sceneTarget);
+        int width = 0, height = 0;
+        r3d_target_get_resolution(&width, &height, source, 0);
+        LINEAR_VIEW_COLOR = (Texture2D){r3d_target_get(source), width, height, 1, PIXELFORMAT_UNCOMPRESSED_R16G16B16};
+        LINEAR_VIEW_DEPTH = (Texture2D){r3d_target_get_depth_buffer(), width, height, 1, 19};
+        LINEAR_VIEW_CAPTURED = LINEAR_VIEW_COLOR.id != 0 && LINEAR_VIEW_DEPTH.id != 0;
+        r3d_stack_reset(R3D.stack);
+        cleanup_after_render();
+        return;
+    }
     sceneTarget = pass_post_output(sceneTarget);
 
     sceneTarget = pass_post_screen(R3D_SCREEN_SHADER_STAGE_OUTPUT, sceneTarget);
