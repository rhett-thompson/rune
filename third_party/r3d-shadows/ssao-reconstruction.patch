@@ -1828,6 +1831,14 @@ void r3d_shader_bind_sampler(r3d_shader_sampler_t sampler, GLuint texture)
     {
         r3d_shader_bind_sampler(R3D_SHADER_SAMPLER_BUFFER_GEOM_NORMAL,
