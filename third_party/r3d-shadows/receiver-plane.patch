+#if defined(RUNE_SURFACE_SHADOW_RECEIVER)
+vec2 L_DirectionalReceiverGradient(Light light, vec3 receiverNormal)
+{
+    // The cofactor matrix transforms a plane normal into projection space.
+    // Its common determinant cancels when solving z as a function of x/y.
+    mat3 projection = mat3(light.viewProj);
+    vec3 plane = cross(projection[1], projection[2]) * receiverNormal.x
+               + cross(projection[2], projection[0]) * receiverNormal.y
+               + cross(projection[0], projection[1]) * receiverNormal.z;
+    float magnitude = length(plane);
+    if (!(magnitude > 0.0) || any(isnan(plane)) || any(isinf(plane)) ||
+        abs(plane.z) <= magnitude * 0.000001)
+    {
+        return vec2(0.0);
+    }
+    vec2 gradient = -plane.xy / plane.z;
+    return (any(isnan(gradient)) || any(isinf(gradient))) ? vec2(0.0) : gradient;
+}
+
+float L_DirectionalReceiverTap(Light light, vec2 pixel, vec2 mapSize,
+                              vec3 projection, vec2 gradient, float bias)
+{
+    // Keep native clamp-to-edge semantics at the map border. Comparing exactly
+    // at a texel center avoids four hardware PCF neighbors sharing one depth.
+    vec2 center = (clamp(pixel, vec2(0.0), mapSize - 1.0) + 0.5) / mapSize;
+    float reference = projection.z + dot(gradient, center - projection.xy) - bias;
+    // Directional maps use D16; allow half a depth quantization step.
+    reference -= 0.5 / 65535.0;
+    return texture(uShadowDirTex, vec4(center, light.shadowLayer, reference));
+}
+
+float L_DirectionalReceiverBilinear(Light light, vec2 uv, vec2 mapSize,
+                                   vec3 projection, vec2 gradient, float bias)
+{
+    vec2 pixel = uv * mapSize - 0.5;
+    vec2 base = floor(pixel);
+    vec2 weight = fract(pixel);
+    float a = L_DirectionalReceiverTap(light, base, mapSize, projection, gradient, bias);
+    float b = L_DirectionalReceiverTap(light, base + vec2(1.0, 0.0), mapSize, projection, gradient, bias);
+    float c = L_DirectionalReceiverTap(light, base + vec2(0.0, 1.0), mapSize, projection, gradient, bias);
+    float d = L_DirectionalReceiverTap(light, base + vec2(1.0, 1.0), mapSize, projection, gradient, bias);
+    return mix(mix(a, b, weight.x), mix(c, d, weight.x), weight.y);
+}
+#endif
+
+float L_SampleShadowDir(Light light, vec3 Pws, float Zvs, float NoL, mat2 diskRot
