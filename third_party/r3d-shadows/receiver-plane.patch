+                        )
 {
     vec4 Pls = light.viewProj * vec4(Pws, 1.0);
     vec3 projCoords = Pls.xyz / Pls.w * 0.5 + 0.5;
     float bias = light.shadowDepthBias + light.shadowSlopeBias * (1.0 - NoL);
     float compareDepth = projCoords.z - bias;
 
+#if defined(RUNE_SURFACE_SHADOW_RECEIVER)
+    vec2 gradient = L_DirectionalReceiverGradient(light, receiverNormal);
+    vec2 mapSize = vec2(textureSize(uShadowDirTex, 0).xy);
+#endif
     float shadow = 0.0;
     for (int i = 0; i < SHADOW_SAMPLES; ++i)
     {
         vec2 offset = diskRot * VOGEL_DISK[i] * light.shadowSoftness;
+#if defined(RUNE_SURFACE_SHADOW_RECEIVER)
+        shadow += L_DirectionalReceiverBilinear(light, projCoords.xy + offset, mapSize, projCoords, gradient, bias);
+#else
         shadow += texture(uShadowDirTex, vec4(projCoords.xy + offset, light.shadowLayer, compareDepth));
+#endif
     }
     shadow /= float(SHADOW_SAMPLES);
 
