+static struct aiPropertyStore* create_import_properties(void)
+{
+    struct aiPropertyStore* properties = aiCreatePropertyStore();
+    if (!properties) return NULL;
+
+    // R3D maps animation channels to mesh bones. FBX pivot helper nodes are
+    // not mesh bones, so keep their transforms on the actual animated joints.
+    aiSetImportPropertyInteger(properties, AI_CONFIG_IMPORT_FBX_PRESERVE_PIVOTS, 0);
+    return properties;
+}
